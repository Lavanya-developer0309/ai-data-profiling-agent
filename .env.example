# Copy to .env and fill in. Same key-pair login as the dbt project.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_USER=MIG_DBT_SVC
SNOWFLAKE_ROLE=MIG_DEVELOPER
SNOWFLAKE_WAREHOUSE=MIG_WH
SNOWFLAKE_DATABASE=HC_MIGRATION_DB
SNOWFLAKE_SCHEMA=STAGING
# Web app
APP_PORT=5050
# APP_SECRET_KEY=   (auto-generated into instance/ if empty)

# AI that proposes the checks: ollama (local, free) | cortex (paid Snowflake only) | none
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
# Cortex model - run test_cortex.py to see which ones your region has
CORTEX_MODEL=mistral-large2

# Pipeline page: where the hc-pipeline project is (reads its state/approvals.db)
PIPELINE_DIR=~/path/to/hc-pipeline
